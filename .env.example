# OpenAI API Key – get from platform.openai.com
OPENAI_API_KEY=your-api-key-here

# Flask secret key – generate a random string
CYBERSHIELD_SECRET_KEY=your-secret-key-here

# Optional: database URL; leave empty to use instance/cybershield.sqlite
DATABASE_URL=

# Set true when serving over HTTPS
CYBERSHIELD_COOKIE_SECURE=false

# Set true only when running behind one trusted proxy (for example on Render)
CYBERSHIELD_TRUST_PROXY=false

# Optional assistant limits: per visitor per 15 minutes, and per day overall
CYBERSHIELD_CHAT_LIMIT=20
CYBERSHIELD_AI_DAILY_CAP=300

# Set true for Flask debug mode during local development only
FLASK_DEBUG=false
